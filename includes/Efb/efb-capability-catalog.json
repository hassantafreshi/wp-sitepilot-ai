{
  "schema_version": "1.0.0",
  "efb_version_target": "4.1.x",
  "purpose": "Authoritative SitePilot capability, storage, and safe-execution catalog for Easy Form Builder. It describes the flat valj_efb/form_structer model; it does not replace EFB's renderer or settings UI.",
  "sources": [
    "EFB-CORE-KNOWLEDGE-BASE.en.md (2026-07-22)",
    "includes/admin/assets/js/val-efb.js",
    "includes/admin/assets/js/admin-efb.js",
    "includes/class-Emsfb-formbuilder.php",
    "includes/functions.php addon registry"
  ],
  "scope_exclusions": [
    "calculation addon and calculate action",
    "quiz addon",
    "ticketing addon"
  ],
  "storage": {
    "form_definition": {
      "table": "{prefix}emsfb_form",
      "columns": {
        "id": "form_id",
        "name": "form_name",
        "structure": "form_structer",
        "email": "form_email",
        "type": "form_type",
        "creator": "form_created_by",
        "access": "form_access_by",
        "created_at": "form_create_date",
        "status": "status"
      },
      "encoding": "json_encode(..., JSON_UNESCAPED_UNICODE), then escape every double quote as \\u005c\" before persistence",
      "shape": "Flat array: index 0 is the form object; subsequent objects are steps, fields, options, and matrix rows. Options and matrix rows reference their owner with parent; never nest them."
    },
    "submissions": {
      "table": "{prefix}emsfb_message",
      "content_column": "content",
      "normalization_note": "Checkbox and multiselect values can be normalized with the @efb! separator; preserve EFB's canonical handling."
    },
    "global_settings": {
      "table": "{prefix}emsfb_setting",
      "column": "setting",
      "format": "JSON object decoded through get_setting_Emsfb('decoded')",
      "ai_write": false,
      "reason": "Global settings can contain credentials, add-on activation, notification destinations, and payment configuration."
    },
    "builder_recovery": {
      "browser_keys": ["valj_efb", "formId_efb", "Edit_ws_form"],
      "note": "The builder saves and reloads the complete array, not individual fields."
    }
  },
  "object_kinds": {
    "form": { "position": 0, "submittable": false },
    "step": { "type": "step", "submittable": false },
    "field": { "submittable": true },
    "option": { "type": "option", "parent_key": "parent", "submittable": false },
    "matrix_row": { "type": "r_matrix", "parent_key": "parent", "submittable": false }
  },
  "form_types": {
    "form": { "status": "implemented", "ai_create": true },
    "payment": { "status": "implemented", "ai_create": false, "requires_payment_gateway": true },
    "survey": { "status": "implemented", "ai_create": false, "privacy_sensitive": true },
    "login": { "status": "implemented", "ai_create": false, "authentication_sensitive": true },
    "register": { "status": "implemented", "ai_create": false, "authentication_sensitive": true },
    "subscribe": { "status": "legacy_runtime", "ai_create": false },
    "smartForm": { "status": "legacy_runtime", "ai_create": false }
  },
  "field_types": {
    "text": { "label": "Text", "category": "basic", "plan": "free", "fillable": true, "ai_create": true },
    "name": { "label": "Name", "category": "basic", "plan": "free", "fillable": true, "ai_create": false, "normalize_to": "text" },
    "email": { "label": "Email", "category": "basic", "plan": "free", "fillable": true, "ai_create": true, "default_properties": ["noti"] },
    "password": { "label": "Password", "category": "basic", "plan": "free", "fillable": true, "ai_create": false, "reason": "Sensitive authentication data" },
    "number": { "label": "Number", "category": "basic", "plan": "free", "fillable": true, "ai_create": true },
    "textarea": { "label": "Long text", "category": "basic", "plan": "free", "fillable": true, "ai_create": true },
    "tel": { "label": "Telephone", "category": "basic", "plan": "free", "fillable": true, "ai_create": true },
    "mobile": { "label": "Mobile phone", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false },
    "url": { "label": "URL", "category": "basic", "plan": "free", "fillable": true, "ai_create": true },
    "date": { "label": "Date", "category": "basic", "plan": "free", "fillable": true, "ai_create": true, "special_properties": ["minimum", "maximum", "date_expiry"] },
    "pdate": { "label": "Persian date", "category": "advanced", "plan": "pro", "fillable": true, "requires_addon": "AdnPDP", "ai_create": false },
    "ardate": { "label": "Arabic/Hijri date", "category": "advanced", "plan": "pro", "fillable": true, "requires_addon": "AdnADP", "ai_create": false },
    "range": { "label": "Range", "category": "basic", "plan": "free", "fillable": true, "ai_create": false, "special_properties": ["minimum", "maximum", "range_thumb_color", "range_value_color"] },
    "color": { "label": "Color", "category": "basic", "plan": "pro", "fillable": true, "ai_create": false },
    "file": { "label": "File upload", "category": "basic", "plan": "free", "fillable": true, "ai_create": true, "special_properties": ["file_category", "custom_file_types", "max_file_size_mb"] },
    "dadfile": { "label": "Drag-and-drop upload", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false, "special_properties": ["file_category", "custom_file_types", "max_file_size_mb"] },
    "audio_recorder": { "label": "Audio recorder", "category": "advanced", "plan": "free", "fillable": true, "ai_create": false, "special_properties": ["record_quality", "max_duration_seconds", "max_file_size_mb", "recorder_countdown", "recorder_download", "recorder_noise"] },
    "video_recorder": { "label": "Video recorder", "category": "advanced", "plan": "free", "fillable": true, "ai_create": false, "special_properties": ["record_quality", "max_duration_seconds", "max_file_size_mb", "recorder_countdown", "recorder_download", "recorder_facing", "recorder_mirror", "recorder_watermark"] },
    "screen_recorder": { "label": "Screen recorder", "category": "advanced", "plan": "free", "fillable": true, "ai_create": false, "special_properties": ["record_quality", "max_duration_seconds", "max_file_size_mb", "recorder_countdown", "recorder_download", "recorder_watermark"] },
    "select": { "label": "Dropdown", "category": "basic", "plan": "free", "fillable": true, "option_children": true, "ai_create": true },
    "radio": { "label": "Radio buttons", "category": "basic", "plan": "free", "fillable": true, "option_children": true, "ai_create": true, "special_properties": ["option_columns", "checked_color"] },
    "checkbox": { "label": "Checkboxes", "category": "basic", "plan": "free", "fillable": true, "option_children": true, "ai_create": true, "special_properties": ["option_columns", "checked_color"] },
    "multiselect": { "label": "Multi-select", "category": "advanced", "plan": "free", "fillable": true, "option_children": true, "ai_create": true, "special_properties": ["min_selections", "max_selections"] },
    "switch": { "label": "Switch", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false, "special_properties": ["switch_on_color", "switch_off_color", "switch_handle_color"] },
    "yesNo": { "label": "Yes / No", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false, "special_properties": ["button_one_text", "button_two_text", "button_color"] },
    "rating": { "label": "Rating", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false },
    "pointr5": { "label": "5-point score", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false },
    "pointr10": { "label": "NPS / 10-point score", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false },
    "imgRadio": { "label": "Image radio", "category": "advanced", "plan": "pro", "fillable": true, "option_children": true, "ai_create": false, "special_properties": ["option_image_url", "option_description"] },
    "trmCheckbox": { "label": "Terms checkbox", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false },
    "chlCheckBox": { "label": "Choice list with quantity", "category": "advanced", "plan": "pro", "fillable": true, "option_children": true, "ai_create": false, "special_properties": ["quantity_placeholder"] },
    "table_matrix": { "label": "Matrix", "category": "advanced", "plan": "pro", "fillable": true, "matrix_row_children": true, "ai_create": false },
    "conturyList": { "label": "Country list", "category": "advanced", "plan": "pro", "fillable": true, "requires_addon": "AdnOF", "ai_create": false, "special_properties": ["country", "display_language"] },
    "stateProvince": { "label": "State / province", "category": "advanced", "plan": "pro", "fillable": true, "requires_addon": "AdnOF", "ai_create": false, "special_properties": ["country", "display_language"] },
    "cityList": { "label": "City list", "category": "advanced", "plan": "pro", "fillable": true, "requires_addon": "AdnOF", "ai_create": false, "special_properties": ["country", "state_province", "display_language"] },
    "address": { "label": "Address", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false },
    "maps": { "label": "Map picker", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": false, "special_properties": ["latitude", "longitude", "map_zoom", "map_marker"] },
    "esign": { "label": "Electronic signature", "category": "advanced", "plan": "pro", "fillable": true, "ai_create": true, "special_properties": ["button_text", "button_color", "icon"], "notes": ["Requires the EFB Pro electronic-signature component to be available in the active installation."] },
    "heading": { "label": "Heading", "category": "layout", "plan": "pro", "fillable": false, "ai_create": true, "special_properties": ["default_value", "input_text_size", "input_text_color", "input_align"] },
    "link": { "label": "Link", "category": "layout", "plan": "pro", "fillable": false, "ai_create": false, "special_properties": ["default_value", "href", "input_text_size", "input_text_color", "input_align"] },
    "html": { "label": "HTML", "category": "layout", "plan": "pro", "fillable": false, "ai_create": false, "reason": "Raw HTML must never be generated or applied automatically" },
    "steps": { "label": "Step", "category": "layout", "plan": "free", "stored_type": "step", "fillable": false, "ai_create": true, "notes": ["Structural item: use add_step, never add_field or heading.", "The EFB Free plan permits two steps; further steps require Pro field components."] },
    "stripe": { "label": "Stripe card", "category": "payment", "plan": "pro", "fillable": true, "requires_addon": "AdnSPF", "ai_create": false, "ai_write": false },
    "paypal": { "label": "PayPal", "category": "payment", "plan": "pro", "fillable": true, "requires_addon": "AdnPAP", "ai_create": false, "ai_write": false },
    "persiaPay": { "label": "Persia Payment", "category": "payment", "plan": "pro", "fillable": true, "requires_addon": "AdnPPF", "ai_create": false, "ai_write": false },
    "zarinPal": { "label": "ZarinPal", "category": "payment", "plan": "pro", "fillable": true, "requires_addon": "AdnPPF", "ai_create": false, "ai_write": false },
    "payCheckbox": { "label": "Priced checkboxes", "category": "payment", "plan": "pro", "fillable": true, "option_children": true, "ai_create": false, "ai_write": false },
    "payRadio": { "label": "Priced radio buttons", "category": "payment", "plan": "pro", "fillable": true, "option_children": true, "ai_create": false, "ai_write": false },
    "paySelect": { "label": "Priced dropdown", "category": "payment", "plan": "pro", "fillable": true, "option_children": true, "ai_create": false, "ai_write": false },
    "payMultiselect": { "label": "Priced multi-select", "category": "payment", "plan": "pro", "fillable": true, "option_children": true, "ai_create": false, "ai_write": false },
    "prcfld": { "label": "Custom price", "category": "payment", "plan": "pro", "fillable": true, "ai_create": false, "ai_write": false },
    "ttlprc": { "label": "Total price", "category": "payment", "plan": "pro", "fillable": false, "ai_create": false, "ai_write": false },
    "hidden": { "label": "Hidden value", "category": "legacy", "plan": "free", "fillable": true, "ai_create": false, "ai_write": false, "reason": "Not exposed in the current palette; preserve when reading legacy forms" },
    "recaptcha": { "label": "reCAPTCHA", "category": "layout", "plan": "configured_service", "fillable": false, "ai_create": false, "ai_write": false },
    "captcha": { "label": "Captcha", "category": "layout", "plan": "configured_service", "fillable": false, "ai_create": false, "ai_write": false },
    "gmap": { "label": "Google map", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "map": { "label": "Map", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "header": { "label": "Header", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "title": { "label": "Title", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "paragraph": { "label": "Paragraph", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "text_block": { "label": "Text block", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "divider": { "label": "Divider", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "hr": { "label": "Horizontal rule", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "image": { "label": "Image", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "button": { "label": "Button", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "submit": { "label": "Submit button", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false },
    "reset": { "label": "Reset button", "category": "layout", "plan": "legacy", "fillable": false, "ai_create": false, "ai_write": false }
  },
  "form_settings_contract": {
    "object_type": { "storage_key": "type", "expected": "form", "role": "object discriminator" },
    "formName": { "role": "stored form title" },
    "steps": { "role": "number of step objects" },
    "EfbVersion": { "role": "builder compatibility marker" },
    "button_single_text": { "role": "single-step submit label" },
    "button_Next_text": { "role": "multi-step next label" },
    "button_Previous_text": { "role": "multi-step previous label" },
    "button_state": { "role": "single/multi-step button presentation" },
    "button_color": { "role": "EFB button class/custom style token" },
    "btns_align": { "role": "button alignment class" },
    "el_height": { "role": "button height class" },
    "corner": { "role": "button corner class" },
    "thank_you": { "role": "msg or rdrct completion mode" },
    "thank_you_message": { "role": "nested confirmation copy: icon, thankYou, done, trackingCode, pleaseFillInRequiredFields, error" },
    "rePage": { "role": "encoded redirect URL when thank_you=rdrct" },
    "trackingCode": { "role": "show tracking/confirmation code" },
    "captcha": { "role": "captcha on/off, only meaningful when service is configured" },
    "private": { "role": "legacy privacy setting" },
    "stateForm": { "role": "logged-in-only form flag" },
    "dShowBg": { "role": "form card/background flag" },
    "show_icon": { "role": "button icon visibility" },
    "show_pro_bar": { "role": "EFB branding/pro bar visibility" },
    "currency": { "role": "payment currency; optional on old forms" },
    "type": { "role": "form, payment, survey, login, register, subscribe, or smartForm" },
    "survey_chart_type": { "role": "none, bar, or pie public-results mode" },
    "loading_type": { "role": "Pro loading-animation style" },
    "loading_color": { "role": "Pro loading-animation color" },
    "email": { "role": "admin notification recipient list" },
    "email_to": { "role": "email field id used as recipient" },
    "sendEmail": { "role": "email notification enablement" },
    "email_sub": { "role": "Pro email subject" },
    "email_temp": { "role": "email template reference" },
    "smsnoti": { "role": "SMS notification toggle; requires AdnSS" },
    "telegramnoti": { "role": "Telegram notification toggle; requires AdnTLG" },
    "logic": { "role": "legacy conditional-logic activation flag" },
    "logic_rules": { "role": "field conditional-logic rules; requires AdnSMF" },
    "notification_rules": { "role": "conditional notification rules; requires AdnSMF" },
    "confirmation_rules": { "role": "conditional confirmation rules; requires AdnSMF" },
    "webhook_rules": { "role": "conditional webhook rules; requires AdnSMF" },
    "column_map": { "role": "Google Sheet binding column mapping; requires AdnGoS" },
    "template": { "role": "Google Sheet visual template; requires AdnGoS" },
    "template_applied": { "role": "Google Sheet template state; requires AdnGoS" },
    "global_mobile_hflabel": { "role": "hide all labels below 768px" }
  },
  "common_field_contract": {
    "id_": { "role": "stable unique field id and logic reference", "required_for": ["field", "step", "option", "r_matrix"] },
    "id_old": { "role": "optional legacy id retained when a prior id changes; preserve when present" },
    "dataId": { "role": "builder DOM/data reference, normally id_ + '-id'" },
    "type": { "role": "field type discriminator" },
    "elementId": { "role": "optional palette id when it differs from type" },
    "parent": { "role": "owner id for option and r_matrix child records" },
    "step": { "role": "owning step number" },
    "amount": { "role": "global ordering counter; increments for every flat item including options" },
    "name": { "role": "visible field label and common submission-map key" },
    "placeholder": { "role": "empty-input hint" },
    "value": { "role": "default/current value; semantics vary by type" },
    "message": { "role": "help/description text" },
    "required": { "role": "EFB flag, stored as 1/0 or string equivalent" },
    "customRequiredMsg": { "role": "optional required-validation message" },
    "mlen": { "role": "maximum length/value/date constraint" },
    "milen": { "role": "minimum length/value/date constraint" },
    "hidden": { "role": "field hidden state" },
    "disabled": { "role": "field disabled state" },
    "showInPublicResults": { "role": "survey public-results visibility" },
    "size": { "role": "desktop width percentage" },
    "mobile_size": { "role": "mobile width percentage; default 100 when absent" },
    "label_position": { "role": "desktop up/beside label position" },
    "mobile_label_position": { "role": "mobile up/beside label position" },
    "label_text_size": { "role": "desktop label size class" },
    "mobile_label_text_size": { "role": "mobile label size class" },
    "label_align": { "role": "desktop label alignment class" },
    "mobile_label_align": { "role": "mobile label alignment class" },
    "message_align": { "role": "desktop description alignment class" },
    "mobile_message_align": { "role": "mobile description alignment class" },
    "op_style": { "role": "desktop choice columns 1/2/3" },
    "mobile_op_style": { "role": "mobile choice columns 1/2/3" },
    "classes": { "role": "custom CSS class string" },
    "id": { "role": "optional HTML/custom identifier" },
    "corner": { "role": "corner class rounded-0 through rounded-5" },
    "label_text_color": { "role": "label color class; may be paired with style_label_color" },
    "el_text_color": { "role": "input/text color class; may be paired with style_el_text_color" },
    "message_text_color": { "role": "help color class; may be paired with style_message_text_color" },
    "el_border_color": { "role": "border color class; may be paired with style_border_color" },
    "icon_color": { "role": "icon color class; may be paired with style_icon_color" },
    "el_text_size": { "role": "input or display text-size class" },
    "el_height": { "role": "input height class" },
    "el_align": { "role": "input/display alignment class" },
    "pro": { "role": "EFB Pro marker; preserve rather than infer" },
    "icon_input": { "role": "optional input icon" }
  },
  "child_object_contracts": {
    "option": {
      "required_keys": ["id_", "dataId", "parent", "type", "value", "id_op", "step", "amount"],
      "type": "option",
      "optional_keys": ["id_old", "id", "price", "sub_value", "src", "l", "n", "s2"],
      "notes": ["payment options store price", "image-radio options can store src/sub_value", "offline geographic options can store l/n/s2"]
    },
    "r_matrix": {
      "required_keys": ["id_", "dataId", "parent", "type", "value", "id_op", "step", "amount"],
      "type": "r_matrix"
    },
    "step": {
      "required_keys": ["id_", "dataId", "type", "id", "name", "step", "amount"],
      "type": "step",
      "optional_keys": ["icon", "visible", "message", "classes", "label_text_size", "el_text_size", "label_text_color", "el_text_color", "message_text_color", "icon_color", "EfbVersion"]
    }
  },
  "field_properties": {
    "label": { "storage_key": "name", "value_type": "string", "max_length": 120, "applies_to": ["*"], "ai_writable": true, "aliases": ["name", "field_name", "title"] },
    "required": { "storage_key": "required", "value_type": "boolean_flag", "applies_to": ["*"], "ai_writable": true, "aliases": ["mandatory"] },
    "placeholder": { "storage_key": "placeholder", "value_type": "string", "max_length": 200, "applies_to": ["*"], "ai_writable": true, "aliases": ["hint", "example"] },
    "help": { "storage_key": "message", "value_type": "string", "max_length": 500, "applies_to": ["*"], "ai_writable": true, "aliases": ["description", "help_text", "message"] },
    "width": { "storage_key": "size", "value_type": "enum", "values": { "full": "100", "half": "50", "third": "33", "quarter": "25" }, "applies_to": ["*"], "ai_writable": true, "aliases": ["size", "desktop_width"] },
    "mobile_width": { "storage_key": "mobile_size", "value_type": "enum", "values": { "full": "100", "half": "50", "third": "33", "quarter": "25" }, "applies_to": ["*"], "ai_writable": true, "aliases": ["mobile_size"] },
    "label_position": { "storage_key": "label_position", "value_type": "enum", "values": ["up", "beside"], "applies_to": ["*"], "ai_writable": true },
    "mobile_label_position": { "storage_key": "mobile_label_position", "value_type": "enum", "values": ["up", "beside"], "applies_to": ["*"], "ai_writable": true },
    "label_size": { "storage_key": "label_text_size", "value_type": "enum", "values": ["fs-3", "fs-4", "fs-5", "fs-6", "fs-7"], "applies_to": ["*"], "ai_writable": true },
    "mobile_label_size": { "storage_key": "mobile_label_text_size", "value_type": "enum", "values": ["fs-3", "fs-4", "fs-5", "fs-6", "fs-7"], "applies_to": ["*"], "ai_writable": true },
    "label_align": { "storage_key": "label_align", "value_type": "enum", "values": { "left": "txt-left", "center": "txt-center", "right": "txt-right" }, "applies_to": ["*"], "ai_writable": true },
    "mobile_label_align": { "storage_key": "mobile_label_align", "value_type": "enum", "values": { "left": "txt-left", "center": "txt-center", "right": "txt-right" }, "applies_to": ["*"], "ai_writable": true },
