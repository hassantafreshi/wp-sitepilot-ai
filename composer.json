{
	"name": "aisaautopilot/ai-plugin",
	"description": "AI Site Assistant AutoPilot — safe AI copilot for WordPress (standalone/BYOK mode).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6 || ^10.5",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpstan/phpstan": "^2.2",
		"php-stubs/wordpress-stubs": "^6.9",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/woocommerce-stubs": "^11"
	},
	"autoload": {
		"psr-4": {
			"AISAAutoPilot\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AISAAutoPilot\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs --warning-severity=0",
		"analyze": "phpstan analyse --configuration=phpstan.neon --memory-limit=2G"
	}
}
