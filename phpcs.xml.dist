<?xml version="1.0"?>
<ruleset name="AI Site Assistant AutoPilot">
	<description>Coding standards for the AI Site Assistant AutoPilot plugin.</description>

	<file>includes</file>
	<file>ai-site-assistant-autopilot.php</file>
	<file>uninstall.php</file>

	<!-- The standards in vendor/, found without the Composer plugin's CodeSniffer.conf (a checkout installed with
	     no plugins, or as root, has none). Paths that start with "." are relative to PHP_CodeSniffer's own folder. -->
	<config name="installed_paths" value="../../wp-coding-standards/wpcs,../../phpcsstandards/phpcsutils,../../phpcsstandards/phpcsextra"/>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<!-- This PSR-4 codebase uses class filenames and scalar type declarations.
	     Keep WordPress safety and I18n checks without imposing legacy filename
	     and PHPDoc conventions that conflict with that architecture. -->
	<rule ref="WordPress-Core">
		<exclude name="WordPress.Files.FileName"/>
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.VariableComment"/>
		<exclude name="Generic.Commenting.DocComment"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="WordPress.WP.I18n.NonSingularStringLiteralDomain"/>
		<exclude name="WordPress.NamingConventions.ValidFunctionName"/>
	</rule>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ai-site-assistant-autopilot"/>
			</property>
		</properties>
	</rule>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
</ruleset>
