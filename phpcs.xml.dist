<?xml version="1.0"?>
<ruleset name="SitePilot AI">
	<description>Coding standards for the SitePilot AI plugin.</description>

	<file>includes</file>
	<file>sitepilot-ai.php</file>
	<file>uninstall.php</file>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>

	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="sitepilot-ai"/>
		</properties>
	</rule>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
</ruleset>
